<?xml version="1.0" encoding="UTF-8"?>
<fmiModelDescription
  fmiVersion="2.0"
  modelName="{{ name }}"
  description="{{ description }}"
  generationTool="ONNX2FMU"
  guid="{{ GUID }}"
  numberOfEventIndicators="0"
  generationDateAndTime="{{ generationDateAndTime }}">

  {%- if modelExchange %}
  <ModelExchange
    modelIdentifier="{{ name }}">
    <SourceFiles>
      <File name="all.c"/>
    </SourceFiles>
  </ModelExchange>
  {%- endif %}

  {%- if coSimulation %}
  <CoSimulation
    modelIdentifier="{{ name }}"
    canHandleVariableCommunicationStepSize="{{ canHandleVariableCommunicationStepSize|lower }}"
    canNotUseMemoryManagementFunctions="{{ canNotUseMemoryManagementFunctions|lower }}"
    canGetAndSetFMUstate="{{ canGetAndSetFMUstate|lower }}"
    canSerializeFMUstate="{{ canSerializeFMUstate|lower }}">
    <SourceFiles>
      <File name="all.c"/>
    </SourceFiles>
  </CoSimulation>
  {%- endif %}

  <LogCategories>
    <Category name="logEvents" description="Log events"/>
    <Category name="logStatusError" description="Log error messages"/>
  </LogCategories>

  <DefaultExperiment startTime="{{ startTime }}" stopTime="{{ stopTime }}"/>

  <ModelVariables>
    <ScalarVariable name="time" valueReference="0" causality="independent" variability="continuous" description="Simulation time">
      <Real/>
    </ScalarVariable>
    {%- for input in inputs %}
    {%- for scalar in input.scalarValues %}
    <ScalarVariable name="{{ scalar.name }}" valueReference="{{ scalar.valueReference }}" causality="{{ input.causality }}" variability="{{ input.variability }}"{% if input.initial %} initial="{{ input.initial }}"{% endif %} description="{%if scalar.label %}{{ scalar.label }}{% else %}{{ input.description }}{% endif %}">
      <{{ input.vType.FMIType }} start="{{ scalar.start }}"/>
    </ScalarVariable>
    {%- endfor %}
    {%- endfor %}
    {%- for output in outputs %}
    {%- for scalar in output.scalarValues %}
    <ScalarVariable name="{{ scalar.name }}" valueReference="{{ scalar.valueReference }}" causality="{{ output.causality }}" variability="{{ output.variability }}"{% if output.initial %} initial="{{ output.initial }}"{% endif %} description="{%if scalar.label %}{{ scalar.label }}{% else %}{{ output.description }}{% endif %}">
      <Real{% if scalar.stateValueReference is defined %} derivative="{{ scalar.stateValueReference + 1 }}"{% endif %}/>
    </ScalarVariable>
    {%- endfor %}
    {%- endfor %}
    {%- for local in locals %}
    {%- for scalar in local.scalarValues %}
    <ScalarVariable name="{{ scalar.name }}" valueReference="{{ scalar.valueReference }}" causality="{{ local.causality }}" variability="{{ local.variability }}" description="{%if scalar.label %}{{ scalar.label }}{% else %}{{ local.description }}{% endif %}" initial="{{ local.initial }}">
      <{{ local.vType.FMIType }} start="{{ scalar.start }}"/>
    </ScalarVariable>
    {%- endfor %}
    {%- endfor %}
  </ModelVariables>

  <ModelStructure>
    <Outputs>
    {%- for output in outputs %}
    {%- if not output.derivativeOf %}
    {%- for scalar in output.scalarValues %}
      <Unknown index="{{ scalar.valueReference + 1 }}"/>
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    {%- for input in inputs %}
    {%- if input.isState %}
    {%- for scalar in input.scalarValues %}
      <Unknown index="{{ scalar.valueReference + 1 }}"/>
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    </Outputs>
    {%- if states %}
    <Derivatives>
    {%- for output in outputs %}
    {%- if output.derivativeOf %}
    {%- for scalar in output.scalarValues %}
      <Unknown index="{{ scalar.valueReference + 1 }}"/>
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    </Derivatives>
    {%- endif %}
    <InitialUnknowns>
    {%- for output in outputs %}
    {%- for scalar in output.scalarValues %}
      <Unknown index="{{ scalar.valueReference + 1 }}"/>
    {%- endfor %}
    {%- endfor %}
    </InitialUnknowns>
  </ModelStructure>

</fmiModelDescription>
